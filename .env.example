# Skopiuj do .env i uzupełnij.

# Lokalnie: ./scripts/baza-lokalna.sh start podnosi klaster i tworzy bazę panel_dev.
DATABASE_URL="postgresql://panel:paneldevpass@127.0.0.1:55432/panel_dev?schema=public"

# Klucz podpisujący ciasteczko sesji. Wygeneruj swój: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3400"

# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
# → Web application. Authorized redirect URI:
#   http://localhost:3400/api/auth/callback/google   (lokalnie)
#   https://lukaszdobija.pl/api/auth/callback/google (produkcja)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Lista adresów e-mail z dostępem do panelu, oddzielona przecinkami.
# Puste pole = nikt nie wejdzie; logowanie Google samo w sobie nie wystarcza.
PANEL_EMAILS=""
